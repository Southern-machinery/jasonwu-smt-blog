{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jasonwu-smt-blog",
  "main": "./src/server.ts",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 9 * * *"],
  },
  "routes": [
    {
      "pattern": "jasonwu.smthelp.eu",
      "custom_domain": true,
    },
  ],
  "vars": {
    "VITE_BASE_URL": "https://jasonwu.smthelp.eu",
    "CMS_PUBLIC_SITE_URL": "https://jasonwu.smthelp.eu",
    "CMS_BACKUP_RETENTION_DAYS": "30",
    "CMS_EMAIL_SENDING_ENABLED": "false",
    "CMS_EMAIL_FROM": "",
    "CMS_EMAIL_TO": "",
    "CMS_PASSWORD_RESET_TTL_MINUTES": "30",
    "VITE_TURNSTILE_SITE_KEY": "",
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "jasonwu-smt-blog-cms",
      "database_id": "3ea1109f-9aed-4a4d-b861-d11eb1bcd63d",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CMS_STORAGE",
      "bucket_name": "jasonwu-smt-blog-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_CACHE",
      "id": "70e604e5885a44d5b535f01d59bb58f7",
    },
  ],
}
